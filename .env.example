# Fronius MCP Server Configuration

# Fronius Device Configuration
FRONIUS_HOST=fronius-inverter
FRONIUS_PORT=80
FRONIUS_PROTOCOL=http
FRONIUS_TIMEOUT=10000
FRONIUS_DEVICE_ID=1
FRONIUS_RETRIES=3
FRONIUS_RETRY_DELAY=1000

# MCP Transport Configuration
# stdio (default) is used by Claude Desktop and most MCP clients.
# Set to "http" to expose a Streamable HTTP endpoint instead.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# Logging Configuration
LOG_LEVEL=info

# Examples for different setups:
#
# Local Fronius device with default settings:
# FRONIUS_HOST=fronius-inverter.local
#
# Fronius device with IP address:
# FRONIUS_HOST=192.168.1.100
#
# Fronius device with HTTPS (some newer models):
# FRONIUS_HOST=192.168.1.100
# FRONIUS_PROTOCOL=https
# FRONIUS_PORT=443
#
# Multiple inverter setup (specify device ID):
# FRONIUS_DEVICE_ID=2
#
# Faster response for local network:
# FRONIUS_TIMEOUT=5000
# FRONIUS_RETRIES=2
#
# HTTP transport (e.g. for remote/containerized MCP clients):
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000